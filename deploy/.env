# Vita AI Companion — Environment Configuration
# Copy to .env and adjust

# --- Postgres (REQUIRED) ---
POSTGRES_USER=tovideo
POSTGRES_PASSWORD=tovideo_dev_password
POSTGRES_DB=vita
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PASSWORD=
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6380

# --- API ---
TOVIDEO_ENV=dev
BIND_HOST=127.0.0.1
SERVER_PORT=8260
TOVIDEO_JWT_SECRET=dev-secret-change-me-32-characters-min
TOVIDEO_AUTO_MIGRATE=true
TOVIDEO_MOCK_GENERATION=true
TOVIDEO_TEMPLATE_STAGES=released,beta,preview
TOVIDEO_MODEL_STAGES=released,beta,preview
TOVIDEO_STORAGE_PROVIDER=s3
TOVIDEO_S3_BUCKET=vita-media
TOVIDEO_S3_ENDPOINT=http://rustfs:9000
TOVIDEO_S3_PUBLIC_URL=http://127.0.0.1:59100/vita-media
TOVIDEO_S3_ACCESS_KEY=vita_rustfs
TOVIDEO_S3_SECRET_KEY=vita_rustfs_secret
TOVIDEO_REDIS_URL=redis://localhost:6380/0
TOVIDEO_DB_DSN=host=localhost port=5433 user=tovideo password=tovideo_dev_password dbname=vita sslmode=disable

# --- Admin ---
TOVIDEO_ADMIN_EMAILS=
ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=8261

# --- Webapp ---
WEBAPP_BIND_HOST=127.0.0.1
WEBAPP_PORT=8263
WEBAPP_ENV=staging
WEBAPP_API_URL=http://api:8080

# --- RustFS ---
RUSTFS_BIND_HOST=127.0.0.1
RUSTFS_API_PORT=59100
RUSTFS_CONSOLE_PORT=59101
RUSTFS_ACCESS_KEY=vita_rustfs
RUSTFS_SECRET_KEY=vita_rustfs_secret

# --- Website ---
WEBSITE_BIND_HOST=127.0.0.1
WEBSITE_PORT=8262

TZ=UTC
