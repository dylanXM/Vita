IMAGE_TAG=prod
VITA_DB_DSN=postgres://user:password@db-host:5432/vita?sslmode=require
VITA_REDIS_URL=redis://:password@redis-host:6379/0
VITA_ENV=prod
BIND_HOST=0.0.0.0
SERVER_PORT=8270
VITA_JWT_SECRET=replace-with-production-secret
VITA_PUBLIC_BASE_URL=https://api.vita.ai
VITA_AUTO_MIGRATE=false
VITA_MOCK_GENERATION=false
VITA_TEMPLATE_STAGES=released
VITA_MODEL_STAGES=released
VITA_STORAGE_PROVIDER=cos
VITA_ADMIN_EMAIL=
VITA_ADMIN_PASSWORD=
VITA_ADMIN_EMAILS=
# --- SMTP (verification-code email) ---
# Leave VITA_SMTP_HOST empty: codes are printed to the server log.
VITA_SMTP_HOST=
VITA_SMTP_PORT=465
VITA_SMTP_USERNAME=
VITA_SMTP_PASSWORD=
VITA_SMTP_FROM=
VITA_SMTP_FROM_NAME=Vita
ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=8261
WEBAPP_BIND_HOST=127.0.0.1
WEBAPP_PORT=8263
WEBAPP_ENV=prod
WEBAPP_API_URL=http://api:8080
TZ=UTC
