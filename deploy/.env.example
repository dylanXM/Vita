# Vita AI Companion — Environment Configuration
# Copy to .env and adjust
#
# Local Compose project name is pinned to "vita" (see compose `name:` + Makefile -p vita)
# so it does not collide with other repos that also use a deploy/ directory.
#
# Host port map (Vita vs ToVideo on the same machine):
#   Postgres 5433 (ToVideo 5432 / 55432)   Redis 6380 (ToVideo 6379 / 56379)
#   API 8260 (ToVideo 8080 / 8156)         Admin 8261 (ToVideo 8157)
#   Website 8262 (ToVideo 8158)            Webapp 8263 (ToVideo 8159)
#   RustFS 59100/59101 (ToVideo 59000/59001)
#   Vite dev: admin 5174, website 5175, webapp 5176 (ToVideo admin/web 5173)

# --- Postgres (REQUIRED) ---
POSTGRES_USER=tovideo
POSTGRES_PASSWORD=tovideo_dev_password
POSTGRES_DB=vita
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PASSWORD=
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6380

# --- API ---
VITA_ENV=dev
BIND_HOST=127.0.0.1
SERVER_PORT=8260
VITA_JWT_SECRET=dev-secret-change-me-32-characters-min
VITA_AUTO_MIGRATE=true
VITA_MOCK_GENERATION=true
VITA_TEMPLATE_STAGES=released,beta,preview
VITA_MODEL_STAGES=released,beta,preview
VITA_AGENT_CONFIG_KEY=dev-agent-config-key-change-me
VITA_AGENT_ENABLED=true
VITA_AGENT_TICK=1m
VITA_FIREBASE_PROJECT_ID=
VITA_FIREBASE_SERVICE_ACCOUNT_BASE64=
VITA_STORAGE_PROVIDER=s3
VITA_S3_BUCKET=vita-media
VITA_S3_ENDPOINT=http://rustfs:9000
VITA_S3_PUBLIC_URL=http://127.0.0.1:59100/vita-media
VITA_S3_ACCESS_KEY=vita_rustfs
VITA_S3_SECRET_KEY=vita_rustfs_secret
VITA_REDIS_URL=redis://localhost:6380/0
VITA_DB_DSN=host=localhost port=5433 user=tovideo password=tovideo_dev_password dbname=vita sslmode=disable

# --- Admin ---
# Seeds the initial dashboard administrator on startup. The password is only
# written when the account has no password yet, so changing it later sticks.
VITA_ADMIN_EMAIL=admin@vita.app
VITA_ADMIN_PASSWORD=Vita@Admin123
# Extra accounts promoted to the admin role (comma separated).
VITA_ADMIN_EMAILS=
# --- SMTP (verification-code email) ---
# Port 465 = implicit TLS, 587 = STARTTLS.
VITA_SMTP_HOST=
VITA_SMTP_PORT=587
VITA_SMTP_USERNAME=
VITA_SMTP_PASSWORD=
VITA_SMTP_FROM=
VITA_SMTP_FROM_NAME=Vita
ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=8261

# --- Webapp ---
WEBAPP_BIND_HOST=127.0.0.1
WEBAPP_PORT=8263
WEBAPP_ENV=staging
WEBAPP_API_URL=http://api:8080

# --- RustFS ---
RUSTFS_BIND_HOST=127.0.0.1
RUSTFS_API_PORT=59100
RUSTFS_CONSOLE_PORT=59101
RUSTFS_ACCESS_KEY=vita_rustfs
RUSTFS_SECRET_KEY=vita_rustfs_secret

# --- Website ---
WEBSITE_BIND_HOST=127.0.0.1
WEBSITE_PORT=8262

TZ=UTC
