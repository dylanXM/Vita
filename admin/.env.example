# Admin dashboard dev config. Copy to `.env` to override.

# The running Vita API the Vite dev server proxies to (`make be-run` listens on
# :8260; the dockerized deploy stack publishes the API on the same port).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8260

# Dev server port for this admin app.
VITE_DEV_PORT=5174

# API base path. Leave as /v1 to use the Vite proxy (no CORS). Set to an absolute
# URL (e.g. https://api.vita.app/v1) for a deployed build talking cross-origin.
VITE_API_BASE_URL=/v1
