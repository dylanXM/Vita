VITA_ENV=dev
VITA_HTTP_ADDR=:8260
VITA_DB_DSN=postgres://tovideo:tovideo_dev_password@127.0.0.1:5433/vita?sslmode=disable
VITA_REDIS_URL=redis://127.0.0.1:6380/0
VITA_JWT_SECRET=dev-secret-change-me-32-characters-min
VITA_MOCK_GENERATION=true
VITA_AGENT_CONFIG_KEY=dev-agent-config-key-change-me
VITA_AGENT_ENABLED=true
VITA_AGENT_TICK=1m
VITA_AUTO_MIGRATE=true
VITA_STORAGE_PROVIDER=s3
VITA_S3_BUCKET=vita-media
VITA_S3_ENDPOINT=http://127.0.0.1:59100
VITA_S3_PUBLIC_URL=http://127.0.0.1:59100/vita-media
VITA_S3_ACCESS_KEY=vita_rustfs
VITA_S3_SECRET_KEY=vita_rustfs_secret
SERVER_PORT=8260
POSTGRES_USER=tovideo
POSTGRES_PASSWORD=tovideo_dev_password
POSTGRES_DB=vita
REDIS_PASSWORD=
VITA_ADMIN_EMAIL=
VITA_ADMIN_PASSWORD=
VITA_ADMIN_EMAILS=
VITA_EMAIL_VERIFICATION=false
# --- SMTP (verification-code email) ---
# Leave VITA_SMTP_HOST empty in dev: codes are printed to the server log.
# Port 465 = implicit TLS, 587 = STARTTLS.
VITA_SMTP_HOST=
VITA_SMTP_PORT=465
VITA_SMTP_USERNAME=
VITA_SMTP_PASSWORD=
VITA_SMTP_FROM=
VITA_SMTP_FROM_NAME=Vita
VITA_STRIPE_SECRET_KEY=
VITA_FCM_CREDENTIALS_JSON=
