#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"
VITA_ADMOB_IOS_APP_ID = ca-app-pub-3940256099942544~1458002511

// google_mobile_ads imports GoogleMobileAds' private GoogleMobileAds_Beta.h.
// While Runner precompiles that framework module clang treats the private
// header as non-modular and turns the warning into an error. Allowing
// non-modular includes in framework modules keeps the build working.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
